    "allure:open": "allure open allure-report",
    "allure:pdf": "node Script/generate-allure-pdf.js",
    "test:report": "npm test && npm run allure:generate && npm run allure:pdf",
    "test:pdf": "npm test; npm run allure:generate; npm run allure:open"
  },
